# ===== Antigravity 网关配置模板 =====
# 复制为 .env 后按需修改。优先级: 系统环境变量 > .env > 代码内默认值

# --- 第三方模型配置 (支持 DeepSeek、OpenRouter、OneAPI/NewAPI 等) ---
TARGET_BASE_URL=https://api.deepseek.com/v1
TARGET_API_KEY=your-api-key-here
TARGET_MODEL=deepseek-chat

# --- 思考模式参数形态: none(默认) | deepseek | openrouter ---
THINKING_STYLE=none
# 是否把历史 reasoning_content 回传上游 (DeepSeek 等推理模型建议 false)
SEND_REASONING_CONTENT=false

# --- System 指令中展示给模型的自定义身份名 ---
LOCAL_MODEL_NAME=Claude Opus 4.8

# --- 官方直通上游 (一般无需改动) ---
OFFICIAL_UPSTREAM=https://cloudcode-pa.googleapis.com

# --- 监听地址与服务端口 ---
HOST=127.0.0.1
PORT=9099
